# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=3000
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# JWT Secret Key - CHANGE THIS TO A RANDOM STRING IN PRODUCTION
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secret-key-CHANGE-THIS-IN-PRODUCTION

# Admin Credentials
ADMIN_USERNAME=CarolinePurcell

# Admin Password Hash
# Generate with: node -e "const bcrypt = require('bcrypt'); bcrypt.hash('Mustang/75', 10).then(console.log);"
# Replace the password below with your actual hashed password
ADMIN_PASSWORD_HASH=$2b$10$YourHashedPasswordHere

# Database Configuration (for future use)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=freshies_db
# DB_USER=admin
# DB_PASSWORD=your-db-password

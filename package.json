{
  "name": "notyourmamasfreshies",
  "version": "1.0.0",
  "description": "Not Your Mama's Freshies - E-commerce website with secure admin dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "generate-secret": "node -e \"console.log(require('crypto').randomBytes(64).toString('hex'))\"",
    "hash-password": "node -e \"const bcrypt = require('bcrypt'); const password = process.argv[1]; bcrypt.hash(password, 10).then(hash => console.log('Hash:', hash));\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ecommerce",
    "freshies",
    "car-fresheners",
    "nodejs",
    "express",
    "security"
  ],
